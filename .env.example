LLM_PROVIDER=mock

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Shared LLM settings
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_CONTEXT_CHARS=12000

# Hybrid planner: auto, always, off
HYBRID_PLANNER_ENABLED=1
HYBRID_PLANNER_MODE=auto
HYBRID_PLANNER_MIN_CONFIDENCE=0.65

# Student data provider for ToolAgent: mock, http
STUDENT_API_PROVIDER=mock
STUDENT_API_BASE_URL=http://localhost:5000
STUDENT_API_TIMEOUT_SECONDS=10
STUDENT_API_TOKEN=
STUDENT_MOCK_DIR=

# Test-only mock modes: template, json, malformed, fake_citation, error
MOCK_LLM_MODE=template
